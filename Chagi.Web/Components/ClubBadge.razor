@inject PublicImages Images
<a class="club-label" href="@($"klubbar/{Uri.EscapeDataString(ClubCatalogService.ResolveClub(Name)?.Id ?? Name)}")"><Avatar Name="@Name" Url="@Images.Club(ClubCatalogService.ResolveClub(Name)?.Id ?? Name)" Alt="@($"Klubblogotyp för {Name}")" Size="small" /><span>@Name</span></a>
@code { [Parameter] public string Name { get; set; } = ""; }
