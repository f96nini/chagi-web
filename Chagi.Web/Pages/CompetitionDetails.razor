@page "/tavlingar/{Id}"
@inherits ResultsPageBase
<PageTitle>@(Competition?.CompetitionName ?? "Tävlingsresultat") · Chagi</PageTitle>
<a class="back-link" href="tavlingar">← Alla tävlingar</a>
<DataStatus Busy="Busy" Error="@Error" Data="Data" Retry="RefreshAsync" />
@if (Competition is { } competition && Data is not null)
{
    var divisions = Divisions;
    var standings = CompetitionClubSummaryService.BuildStandings(divisions);
    <div class="page-intro"><span class="eyebrow">@competition.CompetitionDate.ToString("dd MMMM yyyy") · @competition.CompetitionCity</span><h1>@competition.CompetitionName<span class="accent">.</span></h1><p>@competition.Divisions.Count klasser · @(competition.ParticipantCount.HasValue ? $"{competition.ParticipantCount} deltagare" : "Äldre resultat visar publicerade placeringar, inte en komplett deltagarlista.")</p></div>
    <div class="filter-bar"><label class="search-field"><span class="sr-only">Sök klass, fighter eller klubb</span><span aria-hidden="true">⌕</span><input type="search" placeholder="Sök klass, fighter eller klubb…" @bind="search" @bind:event="oninput" /></label>
        <label>Kön<select @bind="gender"><option value="@GenderFilterMode.All">Alla</option><option value="@GenderFilterMode.Male">Herrar / pojkar</option><option value="@GenderFilterMode.Female">Damer / flickor</option></select></label>
        <label>Gren<select @bind="discipline">@foreach (var d in Enum.GetValues<CompetitionDisciplineE>()) { <option value="@d">@d</option> }</select></label>
        <label>Åldersklass<select @bind="age"><option value="">Alla klasser</option>@foreach(var a in Enum.GetValues<RankingAgeClassE>()) { <option value="@a">@RankingClassFilterService.ToDisplayName(a)</option> }</select></label>
    </div>
    <section class="competition-standings" aria-labelledby="club-standings-title">
        <div class="section-heading compact"><h2 id="club-standings-title">Klubbställning</h2><span class="muted">Guld 5 p · Silver 3 p · Brons 1 p</span></div>
        @if (standings.Count > 0)
        {
            <div class="table-scroll"><table><caption class="sr-only">Klubbarnas medaljtabell i @competition.CompetitionName</caption><thead><tr><th scope="col">Plats</th><th scope="col">Klubb</th><th scope="col">Medaljer</th><th scope="col" class="number">Poäng</th></tr></thead><tbody>
                @foreach (var entry in standings)
                {
                    var club = ClubCatalogService.ResolveClub(entry.ClubName);
                    <tr><td class="rank-number">@entry.Rank</td><td>@if (club is not null) { <a class="name-link" href="@($"klubbar/{Uri.EscapeDataString(club.Id)}/tavlingar/{Id}")">@entry.ClubName</a> } else { @entry.ClubName }</td><td><Medals Gold="entry.GoldCount" Silver="entry.SilverCount" Bronze="entry.BronzeCount" /></td><td class="number points">@entry.TotalPoints</td></tr>
                }
            </tbody></table></div>
        }
        else { <div class="empty-state"><p>Inga klubbresultat matchar filtren.</p></div> }
    </section>
    <a class="competition-leaderboard-link" href="@($"tavlingar/{Id}/medaljtoppen")"><span><span class="eyebrow">FIGHTERS</span><strong>Medaljtoppen</strong><small>Se deltagarnas poängliga för hela tävlingen</small></span><span aria-hidden="true">↗</span></a>
    <div class="section-heading compact"><h2>Klassresultat</h2><span class="muted">@divisions.Count klasser</span></div>
    @if (divisions.Count == 0) { <div class="empty-state"><h2>Inga resultat matchar filtren</h2><p>Prova ett annat kön, en annan gren, åldersklass eller sökning.</p></div> }
    @foreach (var division in divisions)
    {
        <details class="division-card"><summary><span><span class="eyebrow">@division.Discipline</span><strong>@division.Division</strong></span><span class="division-count">@division.Results.Count registrerade @if (HasMatchDetails(division)) { <small class="match-available">Matchdetaljer finns</small> }<span aria-hidden="true">＋</span></span></summary>
            <div class="table-scroll"><table><caption class="sr-only">Resultat i @division.Division</caption><thead><tr><th scope="col">Placering</th><th scope="col">Fighter</th><th scope="col">Klubb</th></tr></thead><tbody>
            @foreach (var result in division.Results)
            {
                var fighter = Data!.Fighters.FirstOrDefault(f => f.Id == result.CompetitorId);
                <tr><td><span class="placement placement-@result.Placement">@(result.Placement > 0 ? result.Placement.ToString() : "–")</span></td><td>@if (fighter != null) { <a class="name-link" href="@($"fighters/{ResultLinks.FighterId(fighter)}")">@result.CompetitorName</a> } else { @result.CompetitorName }</td><td>@result.Team</td></tr>
            }
            </tbody></table></div>
            @if (HasMatchDetails(division)) { <a class="match-details-link" href="@($"tavlingar/{Id}/matcher/{ResultLinks.DivisionId(division.Division)}")">Visa matchdetaljer <span aria-hidden="true">↗</span></a> }
        </details>
    }
}
else if (!Busy && Data != null) { <div class="empty-state"><h1>Tävlingen finns inte</h1><p>Resultaten kan ha uppdaterats. Sök tävlingen i listan.</p></div> }
@code {
    [Parameter] public string Id { get; set; } = "";
    string search = "", age = ""; GenderFilterMode gender = GenderFilterMode.All; CompetitionDisciplineE discipline;
    CompetitionCatalogEntry? Competition => Data?.Competitions.FirstOrDefault(c => ResultLinks.CompetitionId(c) == Id);
    List<CompetitionDivisionEntry> Divisions => Competition?.Divisions.Where(d => (gender == GenderFilterMode.All || (gender == GenderFilterMode.Male ? d.IsMale != false : d.IsMale != true)) && (discipline == CompetitionDisciplineE.Alla || d.Discipline == discipline) && (age == "" || d.AgeClass?.ToString() == age) && (d.Division.Contains(search, StringComparison.OrdinalIgnoreCase) || d.Results.Any(r => r.CompetitorName.Contains(search, StringComparison.OrdinalIgnoreCase) || r.Team.Contains(search, StringComparison.OrdinalIgnoreCase)))).ToList() ?? [];
    bool HasMatchDetails(CompetitionDivisionEntry division) => Competition is { } competition && Data?.MatchHistory.Any(history =>
        history.Date.Date == competition.CompetitionDate.Date && string.Equals(history.Name.Trim(), competition.CompetitionName.Trim(), StringComparison.OrdinalIgnoreCase) &&
        history.Matches.Any(match => match.HasDetailedData && string.Equals(match.Category.Trim(), division.Division.Trim(), StringComparison.OrdinalIgnoreCase))) == true;
}
