@page "/tavlingar/{Id}/matcher/{DivisionId}"
@inherits ResultsPageBase
<PageTitle>Matchdetaljer · @(Competition?.CompetitionName ?? "Chagi")</PageTitle>
<a class="back-link" href="@($"tavlingar/{Id}")">← Till tävlingsresultatet</a>
<DataStatus Busy="Busy" Error="@Error" Data="Data" Retry="RefreshAsync" />
@if (Competition is { } competition && Data is { } data && Matches is { Count: > 0 } matches)
{
    var individual = matches.All(match => match.IsIndividualAttempt);
    var division = competition.Divisions.FirstOrDefault(item => ResultLinks.DivisionId(item.Division) == DivisionId);
    var isPower = division?.Discipline == CompetitionDisciplineE.Kross;
    var isSpec = division?.Discipline == CompetitionDisciplineE.Specialtekniker;
    var tableRows = isPower || isSpec
        ? IndividualAttemptTableService.Build(matches, isSpec, division?.Results) : [];
    var countLabel = isPower ? $"{tableRows.Count} deltagare" : individual
        ? matches.Count == 1 ? "1 deltagarstart" : $"{matches.Count} deltagarstarter"
        : matches.Count == 1 ? "1 möte" : $"{matches.Count} möten";
    <div class="page-intro"><span class="eyebrow">MATCHDETALJER · @competition.CompetitionDate.ToString("d MMMM yyyy")</span><h1>@matches[0].Category<span class="accent">.</span></h1><p>@competition.CompetitionName · @competition.CompetitionCity</p></div>
    @if (matches.Any(match => string.Equals(match.Discipline, "SPARRING", StringComparison.OrdinalIgnoreCase)))
    {
        var standings = SparringMatchSummaryService.Build(matches, division?.Results);
        @if (standings.Count > 0)
        {
            <section class="sparring-summary" aria-labelledby="sparring-summary-title">
                <div class="section-heading compact"><h2 id="sparring-summary-title">Sammanställning</h2><span class="muted">@standings.Count deltagare</span></div>
                <p class="sparring-summary-note">Summering av registrerade avslutade matcher. Poäng avser matchpoäng.</p>
                <div class="table-scroll"><table><caption class="sr-only">Poäng, vinster och flaggor i @matches[0].Category</caption><thead><tr><th scope="col">Deltagare</th><th scope="col">Klubb</th><th scope="col" class="number">Poäng</th><th scope="col" class="number">Vinster</th><th scope="col" class="number">Flaggor</th></tr></thead><tbody>
                    @foreach (var row in standings)
                    {
                        var fighter = data.Fighters.FirstOrDefault(item => string.Equals(
                            ClubCatalogService.NormalizeParticipant($"{item.FullName} - {item.Team}"), row.Participant,
                            StringComparison.OrdinalIgnoreCase));
                        <tr><td>@if (fighter is not null) { <a class="name-link" href="@($"fighters/{ResultLinks.FighterId(fighter)}")">@row.Name</a> } else { @row.Name }</td><td>@row.Club</td><td class="number">@DivisionMatch.FormatScore(row.Points)</td><td class="number">@(row.FinishedMatches > 0 ? row.Wins.ToString() : "–")</td><td class="number">@DivisionMatch.FormatScore(row.Flags)</td></tr>
                    }
                </tbody></table></div>
            </section>
        }
    }
    <div class="match-count"><strong>@countLabel</strong></div>
    @if (isSpec)
    {
        <div class="match-view-switch" role="group" aria-label="Visning av Spec-resultat">
            <button type="button" aria-pressed="@showSpecResultTable" class="@(showSpecResultTable ? "selected" : "")" @onclick="() => showSpecResultTable = true">Resultattabell</button>
            <button type="button" aria-pressed="@(!showSpecResultTable)" class="@(!showSpecResultTable ? "selected" : "")" @onclick="() => showSpecResultTable = false">Detaljer</button>
        </div>
    }
    @if (isPower || (isSpec && showSpecResultTable))
    {
        <section class="individual-results" aria-label="Resultattabell">
            <div class="table-scroll"><table><thead><tr><th scope="col">Position</th><th scope="col">Namn</th><th scope="col" class="number">Resultat</th></tr></thead><tbody>
                @foreach (var row in tableRows)
                {
                    <tr><td class="rank-number">@(row.Position > 0 ? row.Position.ToString() : "–")</td><td>@row.Name</td><td class="number">@FormatResult(row, isSpec)</td></tr>
                }
            </tbody></table></div>
        </section>
    }
    @if (!isPower && (!isSpec || !showSpecResultTable))
    {
        @if (individual && matches.Any(match => match.HasIndividualResults)) { <p class="filter-explanation">Registrerade poäng och försök visas nedan. Medaljplaceringarna finns i resultatlistan.</p> }
        else if (individual) { <p class="filter-explanation">Individuella teknikvärden saknas i underlaget. Registrerade starter visas nedan; medaljplaceringarna finns i resultatlistan.</p> }
        <div class="match-list">
            @foreach (var match in matches)
            {
                <MatchCard Match="match" Matches="matches" Fighters="@data.Fighters" />
            }
        </div>
    }
}
else if (!Busy && Data != null) { <div class="empty-state"><h1>Matchdetaljer saknas</h1><p>Det finns inga publicerade matcher för den här klassen.</p></div> }
@code {
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public string DivisionId { get; set; } = "";
    bool showSpecResultTable = true;
    string? currentDivisionId;
    protected override void OnParametersSet()
    {
        if (currentDivisionId == DivisionId) return;
        showSpecResultTable = true;
        currentDivisionId = DivisionId;
    }
    static string FormatResult(IndividualAttemptTableRow row, bool isSpec)
    {
        if (!row.Best.HasValue) return "–";
        var result = DivisionMatch.FormatScore(row.Best);
        if (isSpec) return $"{result} cm";
        return row.HasSecondResult ? $"{result} ({DivisionMatch.FormatScore(row.Worst)})" : result;
    }
    CompetitionCatalogEntry? Competition => Data?.Competitions.FirstOrDefault(c => ResultLinks.CompetitionId(c) == Id);
    IReadOnlyList<DivisionMatch> Matches => Competition is not { } competition || Data is not { } data ? [] : data.MatchHistory
        .Where(history => history.Date.Date == competition.CompetitionDate.Date && string.Equals(history.Name.Trim(), competition.CompetitionName.Trim(), StringComparison.OrdinalIgnoreCase))
        .SelectMany(history => history.Matches)
        .Where(match => ResultLinks.DivisionId(match.Category) == DivisionId)
        .DistinctBy(match => match.MatchId)
        .OrderBy(match => match.StartTime ?? DateTime.MaxValue)
        .ThenBy(match => match.MatchNumber)
        .ThenBy(match => match.MatchId)
        .ToList();
}
