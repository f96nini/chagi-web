@page "/poangligan"
@page "/ranking"
@inherits ResultsPageBase
<PageTitle>Poängligan · Chagi</PageTitle>
<div class="page-intro"><span class="eyebrow">PLACERINGAR SOM BERÄTTAR MER</span><h1>Poängligan<span class="accent">.</span></h1><p>Jämför medaljpoäng totalt, per klass eller per klubb.</p></div>
<DataStatus Busy="Busy" Error="@Error" Data="Data" Retry="RefreshAsync" />
@if (Data != null)
{
    <div class="ranking-legend"><span><i class="medal gold" aria-hidden="true"></i> Guld <strong>5 p</strong></span><span><i class="medal silver" aria-hidden="true"></i> Silver <strong>3 p</strong></span><span><i class="medal bronze" aria-hidden="true"></i> Brons <strong>1 p</strong></span><a href="om">Så fungerar Poängligan ↗</a></div>
    <div class="filter-bar ranking-filters"><label>Kön<select @bind="gender"><option value="male">Herrar</option><option value="female">Damer</option></select></label>
        <label>Gren<select @bind="discipline">@foreach(var d in Enum.GetValues<CompetitionDisciplineE>()) { <option value="@d">@d</option> }</select></label>
        <label>Åldersklass<select @bind="age"><option value="">Alla klasser</option>@foreach(var a in Enum.GetValues<RankingAgeClassE>()) { <option value="@a">@RankingClassFilterService.ToDisplayName(a)</option> }</select></label>
        <label>Klubb<select @bind="club"><option value="">Alla klubbar</option>@foreach(var c in Data.Fighters.Select(f => f.Team).Distinct().Order(SwedishNameComparer.Instance)) { <option>@c</option> }</select></label>
        <label>Sortera på<select @bind="sortMode"><option value="TotalPoints">Total Poäng</option><option value="Class">Klass</option><option value="Club">Klubb</option></select></label>
    </div>
    <p class="filter-explanation">Alla publicerade resultat räknas med aktuell åldersklass och senast registrerat bälte. Vald klubb avgränsar jämförelsen. Placeringarna gäller alla fighters som ingår i urvalet; i klassvyn räknas de inom varje klass.</p>
    @if (Groups.Count == 0) { <div class="empty-state"><h2>Inga resultat i Poängligan för dessa filter</h2><p>Välj en annan klass, klubb eller gren.</p><button class="text-button" @onclick="Reset">Visa alla resultat ↻</button></div> }
    @foreach (var group in Groups)
    {
        <section class="ranking-section"><div class="section-heading compact"><h2>@group.Title</h2><span class="category-chip">@group.Label</span></div>
            <div class="table-scroll"><table><caption class="sr-only">@group.Label, @group.Title</caption><thead><tr><th scope="col">Plats</th><th scope="col">Fighter</th>@if (sortMode != RankingSortMode.Class) { <th scope="col">Klass</th> }<th scope="col">Klubb</th><th scope="col">Medaljer</th><th scope="col" class="number">Poäng</th></tr></thead><tbody>
            @foreach (var row in group.Rows)
            {
                <tr><td class="rank-number">@row.Entry.PositionLabel</td><td><a class="name-link" href="@($"fighters/{ResultLinks.FighterId(row.Entry.Competitor)}")">@row.Entry.FullName</a></td>@if (sortMode != RankingSortMode.Class) { <td>@row.ClassName</td> }<td><ClubBadge Name="@row.Entry.Team" /></td><td><Medals Gold="row.Entry.GoldCount" Silver="row.Entry.SilverCount" Bronze="row.Entry.BronzeCount" /></td><td class="number points">@row.Entry.Score</td></tr>
            }
            </tbody></table></div>
        </section>
    }
}
@code {
    string gender = "male", age = "", club = ""; CompetitionDisciplineE discipline;
    RankingSortMode sortMode = RankingSortMode.TotalPoints;
    List<RankingDisplayGroup> Groups {
        get {
            if (Data == null) return [];
            var fighters = Data.Fighters.Where(f => club == "" || f.Team == club).Select(f => new Competitor {
                Id = f.Id, FirstName = f.FirstName, LastName = f.LastName, Team = f.Team, IsMale = f.IsMale,
                CurrentAgeClass = f.CurrentAgeClass, LatestBelt = f.LatestBelt,
                Results = f.Results.ToList()
            }).ToList();
            bool selectedGender = gender != "female";
            RankingAgeClassE? selectedAge = Enum.TryParse<RankingAgeClassE>(age, out var parsedAge) ? parsedAge : null;
            return RankingDisplayService.BuildGroups(fighters, selectedGender, discipline, selectedAge, sortMode);
        }
    }
    void Reset() { gender = "male"; age = ""; club = ""; discipline = CompetitionDisciplineE.Alla; sortMode = RankingSortMode.TotalPoints; }
}
