@page "/fighters/{Id}"
@inherits ResultsPageBase
@inject PublicImages Images
<PageTitle>@(Fighter?.FullName ?? "Fighter") · Chagi</PageTitle>
<a class="back-link" href="fighters">← Alla fighters</a>
<DataStatus Busy="Busy" Error="@Error" Data="Data" Retry="RefreshAsync" />
@if (Fighter is { } fighter)
{
    var medals = FighterMedalSummaryService.Build(fighter, Data!.Fighters, discipline);
    <div class="profile-header"><a class="profile-club-logo" href="@($"klubbar/{Uri.EscapeDataString(ClubCatalogService.ResolveClub(fighter.Team)?.Id ?? fighter.Team)}")" aria-label="@($"Till klubbprofilen för {fighter.Team}")"><Avatar Name="@fighter.Team" Url="@Images.Club(ClubCatalogService.ResolveClub(fighter.Team)?.Id ?? fighter.Team)" Alt="@($"Klubblogotyp för {fighter.Team}")" Size="large" /></a><div class="page-intro"><span class="eyebrow">FIGHTERPROFIL · @fighter.Team</span><h1>@fighter.FullName<span class="accent">.</span></h1><p>@(fighter.CurrentAgeClass.HasValue ? RankingClassFilterService.ToDisplayName(fighter.CurrentAgeClass.Value) : "Klass ej angiven") · Senaste registrerade bälte: @fighter.LatestBelt.Name</p></div></div>
    <div class="profile-stats"><div><span>Medaljer</span><Medals Gold="medals.GoldCount" Silver="medals.SilverCount" Bronze="medals.BronzeCount" /></div><div><span>Medaljpoäng</span><strong>@Results.Sum(r => r.PointsAwarded)</strong></div><div><span>Tävlingar</span><strong>@medals.CompetitionCount</strong></div><div><span>Poängligan, samma kön</span><strong>@(medals.PointsLeaguePosition > 0 ? $"#{medals.PointsLeaguePosition}" : "–")</strong></div></div>
    <nav class="profile-tabs" aria-label="Fighterprofil"><button type="button" class="@(!showBadges ? "active" : "")" aria-current="@(!showBadges ? "page" : null)" @onclick="() => showBadges = false">Tävlingshistorik</button><button type="button" class="@(showBadges ? "active" : "")" aria-current="@(showBadges ? "page" : null)" @onclick="() => showBadges = true">Badges</button><a href="@($"fighters/{Id}/vs")">VS · Inbördes möten <span aria-hidden="true">↗</span></a></nav>
    @if (showBadges)
    {
        <div class="section-heading"><h2>Badges<span class="accent">.</span></h2><span class="category-chip">@Badges.Count upplåsta</span></div>
        <FighterBadges Awards="Badges" />
    }
    else
    {
    <div class="section-heading"><h2>Tävlingshistorik<span class="accent">.</span></h2><label class="inline-select">Gren<select @bind="discipline">@foreach(var d in Enum.GetValues<CompetitionDisciplineE>()) { <option value="@d">@d</option> }</select></label></div>
    @if (Results.Count == 0) { <div class="empty-state"><h2>Inga resultat i denna gren</h2><p>Välj en annan gren för att se fler resultat.</p></div> }
    else
    {
        <div class="table-scroll"><table><caption class="sr-only">@fighter.FullName, tävlingshistorik</caption><thead><tr><th scope="col">Tävling</th><th scope="col">Gren / klass</th><th scope="col">Placering</th><th scope="col" class="number">Poäng</th></tr></thead><tbody>
        @foreach (var result in Results)
        {
            var competition = Data.Competitions.FirstOrDefault(c => c.CompetitionDate.Date == result.CompetitionDate.Date && c.CompetitionName == result.CompetitionName && c.CompetitionCity == result.CompetitionCity);
            <tr><td>@if (competition != null) { <a class="name-link" href="@($"tavlingar/{ResultLinks.CompetitionId(competition)}")">@result.CompetitionName</a> } else { <strong>@result.CompetitionName</strong> }<small class="table-small">@result.CompetitionDate.ToString("d MMM yyyy")</small></td><td><strong>@result.Discipline</strong><small class="table-small">@result.Division</small></td><td><span class="placement placement-@result.Placement">@(result.Placement > 0 ? result.Placement.ToString() : "–")</span></td><td class="number points">@result.PointsAwarded</td></tr>
        }
        </tbody></table></div>
    }
    <p class="source-note">Guld ger 5 poäng, silver 3 och brons 1. Vid lika poäng avgör antalet medaljer av varje färg. En saknad placering ger noll poäng.</p>
    }
}
else if (!Busy && Data != null) { <div class="empty-state"><h1>Profilen finns inte</h1><p>Sök efter namnet i fighterlistan. Klubbens namn kan ha uppdaterats.</p></div> }
@code {
    [Parameter] public string Id { get; set; } = "";
    CompetitionDisciplineE discipline;
    bool showBadges;
    ResultsData? badgeData;
    Guid? badgeFighterId;
    IReadOnlyList<CompetitorBadgeAward> badgeAwards = [];
    Competitor? Fighter => Data?.Fighters.FirstOrDefault(f => ResultLinks.FighterId(f) == Id);
    List<CompetitionResult> Results => Fighter?.Results.Where(r => discipline == CompetitionDisciplineE.Alla || r.Discipline == discipline).OrderByDescending(r => r.CompetitionDate).ThenBy(r => r.Discipline).ToList() ?? [];
    IReadOnlyList<CompetitorBadgeAward> Badges {
        get {
            if (Data == null || Fighter is not { } fighter) return [];
            if (!ReferenceEquals(badgeData, Data) || badgeFighterId != fighter.Id) {
                badgeAwards = CompetitorBadgeCalculator.Calculate(fighter, Data.Fighters);
                badgeData = Data;
                badgeFighterId = fighter.Id;
            }
            return badgeAwards;
        }
    }
}
