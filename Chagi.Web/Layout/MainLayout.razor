@inherits LayoutComponentBase
<a class="skip-link" href="#main" @onclick="SkipAsync" @onclick:preventDefault>Hoppa till innehållet</a>
<header class="site-header">
    <div class="header-inner">
        <a class="wordmark" href="" aria-label="Chagi, startsida"><img class="brand-icon" src="images/chagi-icon.png" alt="" width="38" height="38" />chagi<span class="brand-dot">.</span></a>
        <nav aria-label="Huvudmeny">
            <NavLink href="" Match="NavLinkMatch.All">Översikt</NavLink>
            <NavLink href="tavlingar">Tävlingar</NavLink>
            <NavLink href="fighters">Fighters</NavLink>
