<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ITF_Taekwondo_Gradering.Models.Ranking;assembly=Chagi.Core"
             xmlns:local="clr-namespace:ITF_Taekwondo_Gradering"
             x:Class="ITF_Taekwondo_Gradering.CompetitorsPage"
             Title="Fighters">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Klasser"
                     Clicked="OnClassesClicked"
                     Priority="0"
                     Order="Primary" />
    </ContentPage.ToolbarItems>

    <local:AppBackgroundView>
        <Grid Padding="6">
            <CollectionView x:Name="RankingView"
                            BackgroundColor="Transparent"
                            SelectionMode="None"
                            IsGrouped="True"
                            ItemSizingStrategy="MeasureAllItems">
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="10" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                            <ActivityIndicator x:Name="BusyIndicator"
                                               Color="White"
                                               IsVisible="False"
                                               IsRunning="False"
                                               WidthRequest="24"
                                               HeightRequest="24" />
                            <Label x:Name="StatusLabel" Grid.Column="1" Text="" TextColor="White" VerticalOptions="Center" />
                        </Grid>

                        <FlexLayout Direction="Row"
                                    Wrap="Wrap"
                                    AlignItems="Center"
                                    AlignContent="Start"
                                    JustifyContent="SpaceBetween">
                            <local:GenderFilterView x:Name="GenderFilter"
                                    SelectionChanged="OnGenderChanged"
                                    Margin="0,0,8,6"
                                    FlexLayout.Shrink="0" />

                            <Button x:Name="SearchButton"
                                    Text="Sök ..."
                                    Clicked="OnSearchClicked"
                                    Margin="0,0,6,6"
                                    FlexLayout.Shrink="0" />
                            <Button x:Name="BrowseAllButton"
                                    Text="Alla"
                                    Clicked="OnBrowseAllClicked"
                                    Margin="0,0,0,6"
                                    FlexLayout.Shrink="0" />
                        </FlexLayout>

                        <FlexLayout Direction="Row"
                                    Wrap="Wrap"
                                    AlignItems="Start"
                                    AlignContent="Start"
                                    JustifyContent="SpaceBetween">
                            <Button x:Name="AllButton" Text="Alla" Clicked="OnAllClicked"
                                    Padding="10,10" Margin="0,0,6,6" FlexLayout.Shrink="0" />
                            <Button x:Name="TulButton" Text="Tul" Clicked="OnTulClicked"
                                    Padding="10,10" Margin="0,0,6,6" FlexLayout.Shrink="0" />
                            <Button x:Name="SparringButton" Text="Sparr." Clicked="OnSparringClicked"
                                    Padding="10,10" Margin="0,0,6,6" FlexLayout.Shrink="0" />
                            <Button x:Name="SpecButton" Text="Spec" Clicked="OnSpecClicked"
                                    Padding="10,10" Margin="0,0,6,6" FlexLayout.Shrink="0" />
                            <Button x:Name="KrossButton" Text="Kross" Clicked="OnKrossClicked"
                                    Padding="10,10" Margin="0,0,0,6" FlexLayout.Shrink="0" />
                        </FlexLayout>
                    </VerticalStackLayout>
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <Label Text="Ingen ranking hittades för valt filter."
                           TextColor="White"
                           FontSize="14" />
                </CollectionView.EmptyView>

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <Label Text="{Binding Title}"
                               TextColor="White"
                               FontAttributes="Bold"
                               FontSize="16"
                               Margin="0,10,0,4" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:RankedCompetitorEntry">
                        <Border StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#D9E2EC, Dark=#3E4C59}"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1F2933}"
                                StrokeShape="RoundRectangle 4"
                                Margin="0,0,0,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEntryTapped" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="8"
                                  RowSpacing="4"
                                  Padding="10,8">
                                <Label Grid.Column="0"
                                       Text="{Binding PositionDisplayLabel}"
                                       FontAttributes="Bold"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding FullName}"
                                       FontAttributes="Bold"
                                       LineBreakMode="WordWrap"
                                       VerticalTextAlignment="Center" />
                                <Button Grid.Column="2"
                                        Text="{Binding FavoriteGlyph}"
                                        Clicked="OnFavoriteClicked"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        Padding="0"
                                        FontSize="20"
                                        BackgroundColor="Transparent"
                                        TextColor="#D4A017"
                                        CornerRadius="18" />

                                <Grid Grid.Row="1"
                                      Grid.ColumnSpan="3"
                                      ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding Team}"
                                           FontSize="12"
                                           LineBreakMode="WordWrap"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#52606D, Dark=#CBD2D9}" />
                                    <HorizontalStackLayout Grid.Column="1"
                                                           Spacing="6"
                                                           VerticalOptions="Start">
                                        <VerticalStackLayout Spacing="2"
                                                             HorizontalOptions="Center">
                                            <Image Source="gold.png"
                                                   HeightRequest="18"
                                                   WidthRequest="18"
                                                   Aspect="AspectFit"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding GoldCount}"
                                                   FontSize="11"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Spacing="2"
                                                             HorizontalOptions="Center">
                                            <Image Source="silver.png"
                                                   HeightRequest="18"
                                                   WidthRequest="18"
                                                   Aspect="AspectFit"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding SilverCount}"
                                                   FontSize="11"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Spacing="2"
                                                             HorizontalOptions="Center">
                                            <Image Source="bronze.png"
                                                   HeightRequest="18"
                                                   WidthRequest="18"
                                                   Aspect="AspectFit"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding BronzeCount}"
                                                   FontSize="11"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                    <VerticalStackLayout Grid.Column="2"
                                                         Spacing="1"
                                                         MinimumWidthRequest="64"
                                                         HorizontalOptions="End"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding Rating, StringFormat='{}{0:0} p'}"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="End" />
                                        <Label Text="{Binding ResultCount, StringFormat='{}{0} resultat'}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#52606D, Dark=#CBD2D9}"
                                               HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border x:Name="LoadingOverlay"
                    IsVisible="False"
                    BackgroundColor="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}"
                    StrokeThickness="0"
                    Padding="24"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="8">
                    <ActivityIndicator x:Name="OverlayIndicator"
                                       IsVisible="False"
                                       IsRunning="False"
                                       WidthRequest="32"
                                       HeightRequest="32"
                                       HorizontalOptions="Center" />
                    <Label x:Name="OverlayLabel"
                           Text="Laddar..."
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </local:AppBackgroundView>

</ContentPage>
