<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:ITF_Taekwondo_Gradering.Views"
             xmlns:local="clr-namespace:ITF_Taekwondo_Gradering"
             x:Class="ITF_Taekwondo_Gradering.CompetitorDetailsPage">

    <local:AppBackgroundView>
    <Grid>
        <Grid Padding="16"
              RowDefinitions="Auto,Auto,*"
              RowSpacing="12">

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border x:Name="TeamImageBorder"
                    IsVisible="False"
                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1F2933}"
                    Stroke="{AppThemeBinding Light=#D9E2EC, Dark=#3E4C59}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="8">
                <Image x:Name="TeamImage"
                       WidthRequest="72"
                       HeightRequest="72"
                       Aspect="AspectFit" />
            </Border>

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center"
                                 Spacing="4">
                <Label x:Name="CompetitorNameLabel" TextColor="White"
                       FontAttributes="Bold"
                       FontSize="22" />
                <Label x:Name="CompetitorTeamLabel"
                       FontSize="15"
                       TextColor="White" />
                <Label x:Name="CompetitorAgeClassLabel"
                       FontSize="14"
                       IsVisible="False"
                       TextColor="White" />
            </VerticalStackLayout>
            </Grid>

            <Border Grid.Row="1"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#E8ECEF, Dark=#1F2A30}"
                    StrokeShape="RoundRectangle 14"
                    Padding="4">
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                    <Button x:Name="SummaryButton"
                            Grid.Column="0"
                            Text="Medaljer"
                            FontSize="14" Padding="4,10" LineBreakMode="WordWrap"
                            Clicked="OnSummaryClicked"
                            CornerRadius="12" />
                    <Button x:Name="CompetitionsButton"
                            Grid.Column="1"
                            Text="Tävlingar"
                            FontSize="14" Padding="4,10" LineBreakMode="WordWrap"
                            Clicked="OnCompetitionsClicked"
                            CornerRadius="12" />
                    <Button x:Name="BadgesButton"
                            Grid.Column="2"
                            Text="Badges"
                            FontSize="14" Padding="4,10" LineBreakMode="WordWrap"
                            Clicked="OnBadgesClicked"
                            CornerRadius="12" />
                    <Button x:Name="VsButton" Grid.Column="3" Text="VS"
                            FontSize="14" Padding="4,10" LineBreakMode="WordWrap"
                            Clicked="OnVsClicked" CornerRadius="12" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid x:Name="VsView" IsVisible="False" RowDefinitions="Auto,*" RowSpacing="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Inbördes möten" TextColor="White" FontSize="18" FontAttributes="Bold" />
                        <Label Text="Vinster – förluster. Äldre möten beräknas från olika pallplaceringar i samma tävlingsklass."
                               TextColor="White" FontSize="13" />
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="4"
                                BackgroundColor="{AppThemeBinding Light=#E8ECEF, Dark=#1F2A30}">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                <Button x:Name="VsDisciplineButton" Text="Disciplin" FontSize="14" Padding="8,10"
                                        CornerRadius="12" Clicked="OnVsDisciplineClicked" />
                                <Button x:Name="VsOpponentButton" Grid.Column="1" Text="Motståndare" FontSize="14" Padding="8,10"
                                        CornerRadius="12" Clicked="OnVsOpponentClicked" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                    <ScrollView Grid.Row="1" x:Name="VsScrollView">
                        <VerticalStackLayout x:Name="VsHost" Spacing="12" />
                    </ScrollView>
                </Grid>
                <ScrollView x:Name="SummaryView">
                    <VerticalStackLayout Spacing="10">
                    <Border Padding="12" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1F2933}"
                            Stroke="{AppThemeBinding Light=#D9E2EC, Dark=#3E4C59}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Alla medaljer" FontAttributes="Bold" FontSize="18"
                                   HorizontalTextAlignment="Center" />
                            <views:MedalSummaryRowView x:Name="TotalMedalsView" ShowInlineDetails="True" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="12">
                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Stroke="{AppThemeBinding Light=#D9E2EC, Dark=#3E4C59}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1F2933}"
                                StrokeShape="RoundRectangle 12"
                                Padding="12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Sparring"
                                       HorizontalTextAlignment="Center"
                                       FontAttributes="Bold" />
                                <views:MedalSummaryRowView x:Name="SparringDisciplineView" TrophyHeight="32" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="0"
                                Grid.Column="1"
                                Stroke="{AppThemeBinding Light=#D9E2EC, Dark=#3E4C59}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1F2933}"
                                StrokeShape="RoundRectangle 12"
                                Padding="12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Tul"
                                       HorizontalTextAlignment="Center"
                                       FontAttributes="Bold" />
                                <views:MedalSummaryRowView x:Name="TulDisciplineView" TrophyHeight="32" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Stroke="{AppThemeBinding Light=#D9E2EC, Dark=#3E4C59}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1F2933}"
                                StrokeShape="RoundRectangle 12"
                                Padding="12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Spec"
                                       HorizontalTextAlignment="Center"
                                       FontAttributes="Bold" />
                                <views:MedalSummaryRowView x:Name="SpecDisciplineView" TrophyHeight="32" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="1"
                                Stroke="{AppThemeBinding Light=#D9E2EC, Dark=#3E4C59}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1F2933}"
                                StrokeShape="RoundRectangle 12"
                                Padding="12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Kross"
                                       HorizontalTextAlignment="Center"
                                       FontAttributes="Bold" />
                                <views:MedalSummaryRowView x:Name="KrossDisciplineView" TrophyHeight="32" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    </VerticalStackLayout>
                </ScrollView>

                <ScrollView x:Name="CompetitionsView"
                            IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="NoCompetitionsLabel"
                               Text="Inga medaljer registrerade." TextColor="White"
                               FontSize="14"
                               IsVisible="False" />

                        <VerticalStackLayout x:Name="CompetitionsCardsHost"
                                             Spacing="10"
                                             BindableLayout.ItemsSource="{x:Null}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <views:CompetitionCardView Competition="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>

                <ScrollView x:Name="BadgesView"
                            IsVisible="False">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Badges" TextColor="White"
                               FontAttributes="Bold"
                               FontSize="18" />

                    <Label x:Name="NoBadgesLabel"
                           Text="Inga badges upplåsta än." TextColor="White"
                           FontSize="14"
                           IsVisible="False" />

                    <VerticalStackLayout x:Name="BadgesHost"
                                         Spacing="10"
                                BindableLayout.ItemsSource="{x:Null}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0"
                                        Padding="14,12"
                                        MinimumHeightRequest="94"
                                        Stroke="{AppThemeBinding Light=#D9E2EC, Dark=#3E4C59}"
                                        StrokeThickness="1"
                                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1F2933}"
                                        StrokeShape="RoundRectangle 16">
                                    <Grid RowDefinitions="Auto,Auto"
                                          RowSpacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="8">
                                            <Image Grid.Column="0"
                                                   Source="{Binding IconSource}"
                                                   WidthRequest="62"
                                                   HeightRequest="62"
                                                   Aspect="AspectFit"
                                                   VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="2"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="WordWrap" />
                                                <Label Text="{Binding AchievedDateText}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light=#52606D, Dark=#CBD2D9}" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="2"
                                                    Text="i"
                                                    Clicked="OnBadgeInfoClicked"
                                                    IsVisible="{Binding HasInfo}"
                                                    WidthRequest="28"
                                                    HeightRequest="28"
                                                    Padding="0"
                                                    CornerRadius="14"
                                                    FontAttributes="Bold"
                                                    FontSize="14"
                                                    VerticalOptions="Start"
                                                    HorizontalOptions="End"
                                                    BackgroundColor="{AppThemeBinding Light=#DCEAF7, Dark=#24435A}"
                                                    TextColor="{AppThemeBinding Light=#184E77, Dark=#EAF4FB}" />
                                        </Grid>

                                        <Border Grid.Row="1"
                                                IsVisible="{Binding IsInfoVisible}"
                                                Padding="10,8"
                                                Stroke="{AppThemeBinding Light=#A7BED3, Dark=#486581}"
                                                StrokeThickness="1"
                                                BackgroundColor="{AppThemeBinding Light=#D9F8FAFC, Dark=#CC0F1C24}"
                                                StrokeShape="RoundRectangle 12">
                                            <Label Text="{Binding InfoText}"
                                                   FontSize="12"
                                                   LineBreakMode="WordWrap"
                                                   TextColor="{AppThemeBinding Light=#243B53, Dark=#E4ECF2}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>

        <Grid x:Name="MedalistsOverlay"
              IsVisible="False"
              BackgroundColor="#99000000"
              Padding="20"
              InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOverlayTapped" />
            </Grid.GestureRecognizers>

            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1F2933}"
                    StrokeShape="RoundRectangle 16"
                    Padding="18"
                    MaximumWidthRequest="420"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="OverlayTitleLabel"
                           FontAttributes="Bold"
                           FontSize="18" />
                    <Label x:Name="OverlaySubtitleLabel"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#52606D, Dark=#CBD2D9}" />
                    <Label x:Name="OverlayMedalistsLabel"
                           FontSize="15"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
    </local:AppBackgroundView>
</ContentPage>
