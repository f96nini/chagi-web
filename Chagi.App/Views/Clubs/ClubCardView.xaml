<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ITF_Taekwondo_Gradering.Views.ClubCardView"
             x:Name="Self">

    <Border StrokeThickness="1"
            Stroke="{AppThemeBinding Light=#D9E2EC, Dark=#3E4C59}"
            BackgroundColor="{AppThemeBinding Light=#CCF8FAFC, Dark=#CC1F2933}"
            StrokeShape="RoundRectangle 18"
            Padding="14">
        <Grid ColumnDefinitions="36,72,*"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="14"
              RowSpacing="6">
            <Label Text="{Binding Source={x:Reference Self}, Path=Summary.RankLabel}"
                   Grid.RowSpan="2"
                   FontAttributes="Bold"
                   FontSize="18"
                   HorizontalTextAlignment="End"
                   VerticalOptions="Center" />

            <Border Grid.Column="1"
                    Grid.RowSpan="2"
                    WidthRequest="64"
                    HeightRequest="64"
                    Padding="8"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#E8ECEF, Dark=#243B53}"
                    StrokeShape="RoundRectangle 18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Image Source="{Binding Source={x:Reference Self}, Path=Summary.ImageSource}"
                       WidthRequest="48"
                       HeightRequest="48"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Grid.Column="2"
                                 Spacing="6"
                                 VerticalOptions="Center">
                <Label Text="{Binding Source={x:Reference Self}, Path=Summary.Name}"
                       FontAttributes="Bold"
                       FontSize="18"
                       LineBreakMode="WordWrap" />

                <Label Text="{Binding Source={x:Reference Self}, Path=Summary.PointsText}"
                       FontSize="13"
                       FontAttributes="Bold" />

                <Label Text="{Binding Source={x:Reference Self}, Path=Summary.ParticipationText}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=#334E68, Dark=#CBD2D9}" />
            </VerticalStackLayout>

            <HorizontalStackLayout Grid.Column="2"
                                   Grid.Row="1"
                                   Spacing="12"
                                   VerticalOptions="Center">
                <VerticalStackLayout Spacing="2"
                                     HorizontalOptions="Center">
                    <Border WidthRequest="18"
                            HeightRequest="18"
                            Padding="0"
                            StrokeThickness="0"
                            BackgroundColor="Transparent"
                            StrokeShape="Ellipse"
                            HorizontalOptions="Center">
                        <Image Source="gold.png"
                               WidthRequest="18"
                               HeightRequest="18"
                               Aspect="AspectFill" />
                    </Border>
                    <Label Text="{Binding Source={x:Reference Self}, Path=Summary.GoldCount}"
                           FontSize="11"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="2"
                                     HorizontalOptions="Center">
                    <Border WidthRequest="18"
                            HeightRequest="18"
                            Padding="0"
                            StrokeThickness="0"
                            BackgroundColor="Transparent"
                            StrokeShape="Ellipse"
                            HorizontalOptions="Center">
                        <Image Source="silver.png"
                               WidthRequest="18"
                               HeightRequest="18"
                               Aspect="AspectFill" />
                    </Border>
                    <Label Text="{Binding Source={x:Reference Self}, Path=Summary.SilverCount}"
                           FontSize="11"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="2"
                                     HorizontalOptions="Center">
                    <Border WidthRequest="18"
                            HeightRequest="18"
                            Padding="0"
                            StrokeThickness="0"
                            BackgroundColor="Transparent"
                            StrokeShape="Ellipse"
                            HorizontalOptions="Center">
                        <Image Source="bronze.png"
                               WidthRequest="18"
                               HeightRequest="18"
                               Aspect="AspectFill" />
                    </Border>
                    <Label Text="{Binding Source={x:Reference Self}, Path=Summary.BronzeCount}"
                           FontSize="11"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Grid>
    </Border>
</ContentView>
