<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net9.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>ITF_Taekwondo_Gradering</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Chagi</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>se.kinnevalds.chagi</ApplicationId>

		<!-- Versions -->
    <ApplicationDisplayVersion>2.1</ApplicationDisplayVersion>
		<ApplicationVersion>8</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-android|AnyCPU'">
	  <AndroidPackageFormats>aab</AndroidPackageFormats>
	  <AndroidPackageFormat>apk</AndroidPackageFormat>
	  <AndroidUseAapt2>True</AndroidUseAapt2>
	  <AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-android|AnyCPU'">
	  <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<ItemGroup>
        <ProjectReference Include="../Chagi.Core/Chagi.Core.csproj" GlobalPropertiesToRemove="TargetFrameworks" />
		<Compile Remove="checks\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
   <!-- Desktop/debug can read Data from output, while mobile uses packaged MauiAssets. -->
		<None Include="Data\**\*" Exclude="Data\archive\**\*" CopyToOutputDirectory="PreserveNewest" />
		<MauiAsset Include="Data\**\*" Exclude="Data\archive\**\*" LogicalName="Data/%(RecursiveDir)%(Filename)%(Extension)" />
		<MauiAsset Include="$(IntermediateOutputPath)generated-data\filelist.txt" LogicalName="Data/filelist.txt" />
		<MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" Include="Resources\AppIcon\appicon_android_bg.svg" ForegroundFile="Resources\AppIcon\appicon_android_fg.png" BaseSize="432,432" />
		<MauiIcon Include="Resources\AppIcon\appicon.png" BaseSize="512,512" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
        <MauiImage Include="Resources\Images\**\*" />
		<MauiImage Update="Resources\Images\dotnetbot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.8" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Pages\Competitors\AllCompetitorsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\Competitions\CompetitionDetailsCard.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\Competitions\CompetitionCardView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\Competitions\ClubCompetitionCard.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\Summary\MedalSummaryRowView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Pages\Competitors\CompetitorsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Pages\Competitors\CompetitorDetailsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Pages\Settings\SettingsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Pages\Information\InformationPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Pages\Competitions\CompetitionDetailsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Pages\Clubs\ClubsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Pages\Home\MainPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\Clubs\ClubCardView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

	<Target Name="GenerateDataFileList" BeforeTargets="BeforeBuild">
		<ItemGroup>
			<_DataTextFiles Include="Data\**\*.txt" Exclude="Data\archive\**\*" />
		</ItemGroup>
		<MakeDir Directories="$(IntermediateOutputPath)generated-data" />
		<WriteLinesToFile File="$(IntermediateOutputPath)generated-data\filelist.txt" Lines="@(_DataTextFiles->'%(RecursiveDir)%(Filename)%(Extension)')" Overwrite="true" />
	</Target>

	<!-- Embed the rasterized MAUI app images on Windows, preserving all DPI variants.
	     Windows application icons and framework resources keep their native packaging. -->
	<Target Name="EmbedWindowsAppImages" AfterTargets="ResizetizeImages"
			Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<ItemGroup>
			<_ChagiImage Include="@(MauiImage)" Condition="'%(MauiImage.IsAppIcon)' != 'True'" />
			<_ChagiEmbeddedImage Include="$(_MauiIntermediateImages)%(_ChagiImage.Filename).scale-*.*" />
			<EmbeddedResource Include="@(_ChagiEmbeddedImage)" LogicalName="Chagi.Images.%(Filename)%(Extension)" />
			<ContentWithTargetPath Remove="@(_ChagiEmbeddedImage)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
		</ItemGroup>
		<Error Condition="'@(_ChagiEmbeddedImage)' == ''" Text="Windows app images were not embedded." />
	</Target>

	<!-- Publish can reuse a directory from an older build which contained loose images. -->
	<Target Name="RemoveLooseWindowsAppImages" AfterTargets="Publish"
			Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' And '$(PublishDir)' != ''">
		<Delete Files="@(_ChagiEmbeddedImage->'$(PublishDir)%(Filename)%(Extension)')" />
	</Target>

</Project>
